# Copia este archivo como .env y cambia los valores. Nunca subas .env a Git.
# Usa solo letras y numeros en la contrasena: va dentro de las URL de conexion.

# Base de datos
POSTGRES_USER=vpfinanzas
POSTGRES_PASSWORD=cambia_esto
POSTGRES_DB=vpfinanzas
DATABASE_URL=postgresql+psycopg://vpfinanzas:cambia_esto@localhost:5432/vpfinanzas
TEST_DATABASE_URL=postgresql+psycopg://vpfinanzas:cambia_esto@localhost:5432/vpfinanzas_test

# Autenticacion
# Obligatorio, minimo 32 caracteres. Genera uno con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
# Usa true en cualquier entorno con HTTPS
COOKIE_SECURE=false

# Aplicacion
# Separa varios origenes con comas. Nunca uses *.
CORS_ORIGINS=http://localhost:5173
# Monto a partir del cual una nota requiere doble firma, por moneda
NC_UMBRAL_USD=4000.00
NC_UMBRAL_VES=4000.00

# Seed: contrasena comun de los usuarios de demo, solo para desarrollo local
SEED_DEFAULT_PASSWORD=cambia_esto
